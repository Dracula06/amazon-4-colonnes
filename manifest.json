{
 "manifest_version": 3,
 "name": "Amazon — disposition, filtres et badges",
 "version": "1.0.0",
 "description": "Disposition personnalisée 4 colonnes, masquage des pubs/recommandations, badges vendeurs multilingues et exports Discord/GitHub.",
 "permissions": ["storage", "activeTab", "scripting", "declarativeNetRequest"],
 "host_permissions": [
  "https://*.keepa.com/*",
  "https://keepa.com/*"
 ],
 "declarative_net_request": {
  "rule_resources": [
    {
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }
  ]
 },
 "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
 },
 "optional_host_permissions": [
  "https://api.github.com/*",
  "https://discord.com/api/webhooks/*",
  "https://discordapp.com/api/webhooks/*",
  "https://api.telegram.org/*"
 ],
 "action": {
  "default_title": "Amazon 4 Colonnes & Outils",
  "default_popup": "popup.html",
  "default_icon": {
   "16": "icons/icon16.png",
   "32": "icons/icon32.png",
   "48": "icons/icon48.png",
   "128": "icons/icon128.png"
  }
 },
 "background": {
  "service_worker": "src/quick-share/background.js",
  "type": "module"
 },
 "options_ui": {
  "page": "settings.html",
  "open_in_tab": true
 },
 "content_scripts": [
  {
   "matches": [
    "https://www.amazon.fr/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.es/*",
    "https://www.amazon.it/*"
   ],
   "js": [
    "core.js",
    "src/display/reviews-visibility.js",
    "src/display/shipping-lock.js",
    "src/display/affiliate-link.js",
    "src/display/quick-frame.js",
    "amazon.js"
   ],
   "run_at": "document_idle"
  },
  {
   "matches": [
    "https://keepa.com/*",
    "https://*.keepa.com/*"
   ],
   "all_frames": true,
   "js": [
    "src/display/keepa-frame.js"
   ],
   "run_at": "document_start"
  }
 ]
}
