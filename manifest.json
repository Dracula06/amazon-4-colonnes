{
 "manifest_version":3,
 "name":"Amazon — disposition et badges",
 "version":"0.7.1",
 "description":"Correction du parcours DOM des captures avec nettoyage imbriqué.",
 "permissions":["storage","activeTab","scripting"],
 "optional_host_permissions":["https://api.github.com/*"],
 "action":{"default_title":"Partager cette page Amazon sur GitHub"},
 "background":{"service_worker":"src/quick-share/background.js","type":"module"},
 "options_ui":{"page":"settings.html","open_in_tab":true},
 "content_scripts":[{"matches":["https://www.amazon.fr/*"],"js":["core.js","amazon.js"],"run_at":"document_idle"}]
}
